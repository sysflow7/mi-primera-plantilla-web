{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siden-master-v1-1",
  "compatibility_date": "2026-08-20",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/robots.txt",
      "/sitemap.xml"
    ]
  }
}
